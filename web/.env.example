# =============================================================================
# Django web app environment — SEPARATE from the pipeline's root .env
# Copy to web/.env and fill in real values. Never commit web/.env.
# =============================================================================

DJANGO_SECRET_KEY=generate-a-long-random-50+-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Reuse the SAME PostgreSQL the pipeline uses.
# NOTE: host port is 5433, not 5432 (a native Windows pg18 owns 5432 — see buglog db-001).
# Django creates ONLY its own tables (users, auth_*, django_*).
# It NEVER touches `articles` or `youtube_videos`.
DATABASE_URL=postgres://ai_news_user:changeme_in_production@127.0.0.1:5433/ai_news

# Redis — cache backend for rate-limiting (see M6's docker/docker-compose.yml
# `redis` service). DB index 1, distinct from the pipeline's Celery use of DB 0.
REDIS_URL=redis://127.0.0.1:6379/1

# M9 — semantic search's query-embedding Celery client points at the
# PIPELINE's broker/backend DB (0) — deliberately a SEPARATE var from
# REDIS_URL above (DB 1). Never reuse REDIS_URL for this; see
# .wolf/cerebrum.md for the DB-index-collision incident this convention
# exists to prevent.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# M13 — real email delivery for verification/password-reset mail. Reuses the
# SAME Gmail App Password credentials app/services/email_sender.py already
# uses for digest emails (see the pipeline's own root .env.example for how
# to generate one) — copy the identical values here too, since Django reads
# ONLY web/.env, never the pipeline's root .env. Leave both blank to fall
# back to the console backend (emails print to the dev server's stdout
# instead of sending — zero setup, the previous default).
# -----------------------------------------------------------------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# M13 — Stripe (test mode). Get free test-mode keys at https://stripe.com
# (Dashboard -> Developers -> API keys; no business verification needed for
# test mode). STRIPE_PRICE_ID_PRO is the Price object for the Pro plan
# (Dashboard -> Product catalog -> create a product -> copy its Price ID,
# starts with "price_"). STRIPE_WEBHOOK_SECRET comes from either the
# Dashboard's webhook endpoint config or `stripe listen` (Stripe CLI) for
# local dev — without it, the webhook view cannot verify event signatures
# and will reject every event as a safety default, not silently trust them.
# Leave all three blank to run with billing/upgrade disabled (the pricing
# page shows an honest "billing isn't configured yet" state instead of
# crashing).
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
