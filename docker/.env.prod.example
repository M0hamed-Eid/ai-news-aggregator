# =============================================================================
# Variables for docker-compose.prod.yml ITSELF (docker compose auto-loads a
# file named ".env" from the same directory as the compose file). Copy to
# docker/.env — never commit it. This is SEPARATE from ../.env.prod (the
# pipeline/worker/beat containers' env_file) and ../web/.env.prod (the web
# container's env_file) — see docs/DEPLOYMENT.md for the full env var map.
# =============================================================================

# The domain (or free DDNS hostname, e.g. yourname.duckdns.org) pointed at
# this VM's public IP — Caddy requests/renews its Let's Encrypt cert for
# this exact value. Must resolve publicly before first `docker compose up`,
# or Caddy's ACME challenge will fail.
SITE_DOMAIN=app.example.com
