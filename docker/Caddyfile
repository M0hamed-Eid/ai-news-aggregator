# Reverse proxy + automatic HTTPS for the production app.
#
# {$SITE_DOMAIN} — set via the environment (docker-compose.prod.yml's caddy
# service reads it from the shell, e.g. `SITE_DOMAIN=app.example.com` or a
# free DDNS hostname such as yourname.duckdns.org — see docs/DEPLOYMENT.md).
# Caddy requests/renews a Let's Encrypt cert for it automatically; no manual
# certbot step.

{$SITE_DOMAIN} {
	# M14 Phase D — streaming chat responses get their OWN route, routed to
	# the isolated `chat` service (uvicorn/ASGI, docker-compose.prod.yml)
	# instead of `web` (gunicorn/WSGI, 2 sync workers — a long-lived stream
	# there would pin one of only 2 workers for the whole response). Must
	# stay OUTSIDE `encode gzip` below — gzip buffers the full response
	# before compressing, which would defeat incremental delivery entirely —
	# and `flush_interval -1` tells Caddy to push each chunk to the client
	# immediately rather than batching. `handle` blocks are evaluated
	# first-match-wins, so this is checked before every other block.
	handle /assistant/stream/* {
		reverse_proxy chat:8001 {
			flush_interval -1
		}
	}

	# M15 — every URL prefix Django still owns (the JSON API surface plus
	# the handful of surfaces staying server-rendered — admin, static
	# assets, email-linked password-reset/verification pages). Keep this
	# list in sync with frontend/next.config.ts's DJANGO_PREFIXES, which
	# proxies the exact same set in local dev via Next.js rewrites().
	# Everything NOT matched here (home, search, feed, article/video/entity
	# detail, sources, people, insights, library, profile, billing,
	# preferences, onboarding, login/signup, pricing, ops, story clusters,
	# trending stories — i.e. the whole Z.ai-designed app shell) falls
	# through to `frontend`. M15 Phase 5 retired the classic (non-API)
	# apps.news/apps.onboarding template routes entirely — those apps'
	# real JSON APIs live under /api/news/* and /api/onboarding/*
	# (already covered by /api/*), so bare /news/* and /onboarding/* are
	# no longer Django-owned at all.
	@django_paths path /api/* /admin/* /accounts/* /behavior/* /assistant/* /healthz/* /r/* /static/*
	handle @django_paths {
		reverse_proxy web:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	encode gzip

	header {
		# Django's own SECURE_* settings (web/config/settings/prod.py) already
		# add HSTS/nosniff/etc. at the app layer — this only adds the one
		# header Django can't set for itself: hiding the proxy from casual
		# fingerprinting is Caddy's job, not Django's.
		-Server
	}
}
