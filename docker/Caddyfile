# Reverse proxy for the production API backend.
#
# API-ONLY — the frontend is on Vercel (a separate domain), and Vercel's own
# Next.js server proxies API calls to this backend server-side (see
# frontend/next.config.ts's rewrites() and BACKEND_ORIGIN). Because the
# browser only ever talks to Vercel's HTTPS domain — never this IP directly
# — this backend deliberately runs PLAIN HTTP, no domain, no Let's Encrypt.
# (An earlier version of this file used a real domain + automatic HTTPS;
# dropped per an explicit user decision to avoid even a free DDNS domain.
# Automatic HTTPS requires a real domain name — Let's Encrypt cannot issue a
# certificate for a bare IP — so serving this IP directly to a browser would
# mean either no HTTPS at all, which Vercel's HTTPS page would refuse to
# call [mixed content], or a self-signed cert, which browsers reject outright.
# The Vercel-side proxy sidesteps both: the browser never sees this origin.)
#
# `:80` — listen on plain HTTP, any hostname/IP. No {$SITE_DOMAIN}, no TLS
# directives; Caddy makes zero outbound ACME calls in this mode.

:80 {
	# M14 Phase D — streaming chat responses get their OWN route, routed to
	# the isolated `chat` service (uvicorn/ASGI, docker-compose.prod.yml)
	# instead of `web` (gunicorn/WSGI, 2 sync workers — a long-lived stream
	# there would pin one of only 2 workers for the whole response). Must
	# stay OUTSIDE `encode gzip` below — gzip buffers the full response
	# before compressing, which would defeat incremental delivery entirely —
	# and `flush_interval -1` tells Caddy to push each chunk to the client
	# immediately rather than batching. `handle` blocks are evaluated
	# first-match-wins, so this is checked before every other block.
	handle /assistant/stream/* {
		reverse_proxy chat:8001 {
			flush_interval -1
		}
	}

	# Everything else goes to Django — this domain is API-only now (the
	# app shell itself is served from Vercel, a separate domain, and calls
	# this one cross-origin for /api/*, /accounts/*, /behavior/*, etc.).
	# No frontend fallback to route to anymore, so unlike the old
	# @django_paths allowlist, unmatched paths just reach Django directly
	# and get its own normal 404 instead of silently falling through to a
	# frontend container that no longer exists here.
	handle {
		reverse_proxy web:8000
	}

	encode gzip

	header {
		# Django's own SECURE_* settings (web/config/settings/prod.py) already
		# add HSTS/nosniff/etc. at the app layer — this only adds the one
		# header Django can't set for itself: hiding the proxy from casual
		# fingerprinting is Caddy's job, not Django's.
		-Server
	}
}
